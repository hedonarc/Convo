{
  "name": "convo",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=24.15.0",
    "pnpm": ">=11.1.1"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --mode dev --port 5173",
    "qa": "vite --mode qa --port 5174",
    "prod": "vite --mode prod --port 5175",
    "c1": "vite --mode client1 --port 6001",
    "c2": "vite --mode client2 --port 6002",
    "c3": "vite --mode client3 --port 6003",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "preview": "vite preview",
    "build:dev": "vite build --mode dev",
    "build:qa": "vite build --mode qa",
    "build:prod": "vite build --mode prod",
    "build:client1": "vite build --mode client1",
    "build:client2": "vite build --mode client2",
    "build:client3": "vite build --mode client3"
  },
  "dependencies": {
    "@fontsource/abel": "^5.2.7",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/roboto": "^5.2.10",
    "class-variance-authority": "^0.7.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@eslint/js": "^10.0.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/vite": "^4.3.0",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "lightningcss": "^1.32.0",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
